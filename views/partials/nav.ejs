<header class="no-print border-b border-stone-200 bg-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3">
    <a href="/" class="flex items-center gap-2 font-semibold text-stone-900">
      <span class="grid h-8 w-8 place-items-center rounded-xl bg-teal-800 text-sm font-bold text-white">IR</span>
      <span>InspectorReady <span class="text-teal-800">ZW</span></span>
    </a>
    <nav class="flex flex-wrap items-center gap-1 text-sm">
      <% if (user) { %>
        <% if (isDemo) { %>
          <span class="mr-1 rounded-full bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-800">Demo mode</span>
        <% } %>
        <a class="rounded-md px-3 py-1.5 text-stone-600 hover:bg-stone-100 hover:text-stone-900" href="/dashboard">Dashboard</a>
        <a class="rounded-md px-3 py-1.5 text-stone-600 hover:bg-stone-100 hover:text-stone-900" href="/activities">Activities</a>
        <a class="rounded-md px-3 py-1.5 text-stone-600 hover:bg-stone-100 hover:text-stone-900" href="/export">Export</a>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="rounded-md px-3 py-1.5 text-stone-600 hover:bg-stone-100 hover:text-stone-900" type="submit">Log out</button>
        </form>
      <% } else { %>
        <a class="rounded-md px-3 py-1.5 text-stone-600 hover:bg-stone-100 hover:text-stone-900" href="/login">Log in</a>
        <a class="rounded-xl bg-teal-800 px-3 py-1.5 font-medium text-white hover:bg-teal-900" href="/signup">Create account</a>
      <% } %>
    </nav>
  </div>
</header>

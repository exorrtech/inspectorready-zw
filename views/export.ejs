<%- include('partials/head') %>

<%
  const lawfulLabel = (value) =>
    (LAWFUL_BASES.find(function (basis) { return basis.value === value; }) || {}).label || value || '';
  const statusLabel = (status) => String(status || '').replace(/_/g, ' ');
%>

<div class="no-print mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-4">
  <a href="/dashboard" class="text-sm font-medium text-slate-600 hover:text-slate-900">← Back to dashboard</a>
  <button type="button" onclick="window.print()" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-800">Print / Save as PDF</button>
</div>

<main class="print-page mx-auto mb-10 max-w-6xl bg-white p-6 shadow-sm sm:p-8">
  <header class="border-b-2 border-slate-900 pb-4">
    <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500">Record of Processing Activities · POTRAZ Form DP1</p>
    <h1 class="mt-2 text-2xl font-bold tracking-tight"><%= org.registered_name || org.name %></h1>
    <p class="mt-1 text-sm text-slate-700"><%= org.name %> · <%= org.sector %></p>
    <p class="text-sm text-slate-600">
      <%= org.contact_email %>
      <% if (org.reg_number) { %> · Registration <%= org.reg_number %><% } %>
    </p>
  </header>

  <div class="mt-4 rounded border border-amber-300 bg-amber-50 p-3 text-xs leading-relaxed text-amber-900">
    <strong>Disclaimer:</strong> This tool helps you produce documentation. It is not legal advice, and it does not replace review by a qualified professional.
  </div>

  <section class="mt-7">
    <h2 class="text-lg font-bold">1. Record of Processing Activities</h2>
    <% if (!activities.length) { %>
      <p class="mt-3 text-sm text-slate-600">No processing activities have been recorded.</p>
    <% } else { %>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full border-collapse text-left text-[11px]">
          <thead>
            <tr class="bg-slate-100">
              <th class="border border-slate-300 px-2 py-2 font-semibold">Category of data subjects</th>
              <th class="border border-slate-300 px-2 py-2 font-semibold">Description of personal data</th>
              <th class="border border-slate-300 px-2 py-2 font-semibold">Purpose of processing</th>
              <th class="border border-slate-300 px-2 py-2 font-semibold">Recipients</th>
              <th class="border border-slate-300 px-2 py-2 font-semibold">Storage location</th>
              <th class="border border-slate-300 px-2 py-2 font-semibold">Cross-border</th>
              <th class="border border-slate-300 px-2 py-2 font-semibold">Retention</th>
              <th class="border border-slate-300 px-2 py-2 font-semibold">Security measures</th>
            </tr>
          </thead>
          <tbody>
            <% activities.forEach(function (activity) { %>
              <tr class="align-top">
                <td class="border border-slate-300 px-2 py-2"><%= activity.data_subject_category %></td>
                <td class="border border-slate-300 px-2 py-2">
                  <%= activity.data_description %>
                  <% if (activity.is_sensitive) { %><span class="mt-1 block font-semibold text-red-700">Sensitive data</span><% } %>
                </td>
                <td class="border border-slate-300 px-2 py-2">
                  <%= activity.purpose %>
                  <span class="mt-1 block text-slate-500">Basis: <%= lawfulLabel(activity.lawful_basis) %></span>
                </td>
                <td class="border border-slate-300 px-2 py-2"><%= activity.recipients || '—' %></td>
                <td class="border border-slate-300 px-2 py-2"><%= activity.storage_location %></td>
                <td class="border border-slate-300 px-2 py-2">
                  <%= activity.cross_border ? 'Yes' : 'No' %>
                  <% if (activity.cross_border) { %><span class="mt-1 block font-semibold text-amber-700">Authorisation required</span><% } %>
                </td>
                <td class="border border-slate-300 px-2 py-2"><%= activity.retention || '—' %></td>
                <td class="border border-slate-300 px-2 py-2"><%= activity.security_measures || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold">2. Compliance evidence summary</h2>
    <p class="mt-2 text-sm text-slate-700">Readiness score: <strong><%= stats.score %>%</strong> (<%= stats.done %> of <%= stats.total %> items done)</p>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full border-collapse text-left text-[11px]">
        <thead>
          <tr class="bg-slate-100">
            <th class="border border-slate-300 px-2 py-2 font-semibold">Compliance item</th>
            <th class="border border-slate-300 px-2 py-2 font-semibold">Status</th>
            <th class="border border-slate-300 px-2 py-2 font-semibold">Evidence note</th>
            <th class="border border-slate-300 px-2 py-2 font-semibold">Date</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function (item) { %>
            <tr class="align-top">
              <td class="border border-slate-300 px-2 py-2"><%= item.title %></td>
              <td class="border border-slate-300 px-2 py-2 capitalize"><%= statusLabel(item.status) %></td>
              <td class="border border-slate-300 px-2 py-2"><%= item.evidence_note || '—' %></td>
              <td class="border border-slate-300 px-2 py-2"><%= item.evidence_date || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <footer class="mt-8 border-t border-slate-300 pt-3 text-xs text-slate-500">
    Generated by InspectorReady ZW on <%= generatedAt %>. Recheck current POTRAZ requirements before submission.
  </footer>
</main>

</body>
</html>

<%- include('partials/head') %>
<%- include('partials/nav') %>
<%- include('partials/flash') %>

<main class="mx-auto max-w-6xl px-4 py-8">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm text-stone-500"><%= org.name %> · <%= org.sector %></p>
      <h1 class="mt-1 text-2xl font-bold tracking-tight">Compliance dashboard</h1>
    </div>
    <a href="/export" class="rounded-xl bg-stone-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-stone-800">Open export pack</a>
  </div>

  <% if (isDemo) { %>
    <div class="mt-5 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      You are viewing the read-only demo. <a href="/signup" class="font-semibold underline">Create an account</a> to make changes.
    </div>
  <% } %>

  <section class="mt-6 rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-stone-500">Readiness score</p>
        <p class="mt-1 text-4xl font-bold tracking-tight"><%= stats.score %>%</p>
        <p class="mt-1 text-sm text-stone-500"><%= stats.done %> of <%= stats.total %> items marked done</p>
      </div>
      <a href="#checklist" class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50">Review checklist</a>
    </div>
    <div class="mt-4 h-2 overflow-hidden rounded-full bg-stone-100">
      <div class="h-2 rounded-full bg-teal-600" style="width: <%= stats.score %>%"></div>
    </div>
  </section>

  <section id="checklist" class="mt-8">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <h2 class="text-lg font-semibold">Compliance checklist</h2>
      <p class="text-sm text-stone-500">The eight items an inspector may ask to see.</p>
    </div>

    <div class="mt-4 space-y-3">
      <% items.forEach(function (item) { %>
        <div id="<%= item.code %>" class="rounded-xl border border-stone-200 bg-white p-4 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h3 class="font-medium"><%= item.title %></h3>
              <p class="mt-0.5 text-xs text-stone-500"><%= item.code %></p>
            </div>
            <% var badge = item.status === 'done' ? 'bg-teal-50 text-teal-800' : item.status === 'in_progress' ? 'bg-amber-50 text-amber-700' : 'bg-stone-100 text-stone-600'; %>
            <span class="rounded-full px-2.5 py-1 text-xs font-medium <%= badge %>"><%= item.status.replace(/_/g, ' ') %></span>
          </div>

          <% if (item.evidence_note || item.evidence_date) { %>
            <p class="mt-3 text-sm text-stone-600">
              <%= item.evidence_note || '' %>
              <% if (item.evidence_date) { %><span class="text-stone-500">· <%= item.evidence_date %></span><% } %>
            </p>
          <% } %>

          <% if (!isDemo) { %>
            <form method="post" action="/checklist/<%= item.code %>" class="mt-4 grid gap-3 sm:grid-cols-[140px_1fr_150px_auto] sm:items-end">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="block text-xs font-medium text-stone-600">
                Status
                <select name="status" class="mt-1 w-full rounded-md border border-stone-300 bg-white px-2 py-1.5 text-sm">
                  <option value="missing" <%= item.status === 'missing' ? 'selected' : '' %>>Missing</option>
                  <option value="in_progress" <%= item.status === 'in_progress' ? 'selected' : '' %>>In progress</option>
                  <option value="done" <%= item.status === 'done' ? 'selected' : '' %>>Done</option>
                </select>
              </label>
              <label class="block text-xs font-medium text-stone-600">
                Evidence note
                <input name="evidence_note" value="<%= item.evidence_note || '' %>" maxlength="500" class="mt-1 w-full rounded-md border border-stone-300 px-2 py-1.5 text-sm" placeholder="Licence number, date submitted, URL...">
              </label>
              <label class="block text-xs font-medium text-stone-600">
                Date
                <input type="date" name="evidence_date" value="<%= item.evidence_date || '' %>" class="mt-1 w-full rounded-md border border-stone-300 px-2 py-1.5 text-sm">
              </label>
              <button type="submit" class="rounded-xl bg-stone-900 px-3 py-2 text-sm font-medium text-white hover:bg-stone-800">Save</button>
            </form>
          <% } else { %>
            <p class="mt-3 text-xs text-amber-700">Read-only in demo mode.</p>
          <% } %>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="mt-8">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <h2 class="text-lg font-semibold">Processing activities</h2>
      <div class="flex items-center gap-3 text-sm">
        <a href="/activities" class="text-stone-600 hover:text-stone-900">View all</a>
        <% if (!isDemo) { %>
          <a href="/activities/new" class="rounded-xl bg-teal-800 px-3 py-1.5 font-medium text-white hover:bg-teal-900">Add activity</a>
        <% } %>
      </div>
    </div>

    <% if (!activities.length) { %>
      <div class="mt-4 rounded-xl border border-dashed border-stone-300 bg-white p-6 text-sm text-stone-600">
        No processing activities yet. Add the first category of personal data your organisation holds.
      </div>
    <% } else { %>
      <div class="mt-4 overflow-x-auto rounded-xl border border-stone-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm">
          <thead class="bg-stone-50 text-xs uppercase tracking-wide text-stone-500">
            <tr>
              <th class="px-4 py-3 font-medium">Data subjects</th>
              <th class="px-4 py-3 font-medium">Purpose</th>
              <th class="px-4 py-3 font-medium">Storage</th>
              <th class="px-4 py-3 font-medium">Flags</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            <% activities.forEach(function (activity) { %>
              <tr>
                <td class="px-4 py-3"><%= activity.data_subject_category %></td>
                <td class="px-4 py-3 text-stone-600"><%= activity.purpose %></td>
                <td class="px-4 py-3 text-stone-600"><%= activity.storage_location %></td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap gap-1">
                    <% if (activity.is_sensitive) { %><span class="rounded bg-red-50 px-2 py-0.5 text-xs text-red-700">Sensitive</span><% } %>
                    <% if (activity.cross_border) { %><span class="rounded bg-amber-50 px-2 py-0.5 text-xs text-amber-700">Cross-border</span><% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
